{
  "id": "PIdETjcXNIk",
  "title": "Pi to Pi: Two-Way Agent Orchestration with the Pi Coding Agent",
  "channel": "IndyDevDan",
  "channel_id": "UC_x36zCEGilGpB1m-V4gmjg",
  "uploader": "IndyDevDan",
